                    <text x="210" y="32" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono" font-weight="600">ATI</text>
                    <rect x="330" y="14" width="140" height="28" rx="4" fill="#2E1F0F" stroke="#C2703E" stroke-width="1"/>
                    <text x="400" y="32" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono" font-weight="600">MoWSA</text>
                    <rect x="520" y="14" width="140" height="28" rx="4" fill="#2E1F0F" stroke="#C2703E" stroke-width="1"/>
                    <text x="590" y="32" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono" font-weight="600">EDRMC</text>

                    <!-- Arrows down to Fayda ID -->
                    <line x1="210" y1="42" x2="340" y2="58" stroke="#C2703E" stroke-width="1" marker-end="url(#g2p-arrow)"/>
                    <line x1="400" y1="42" x2="400" y2="58" stroke="#C2703E" stroke-width="1" marker-end="url(#g2p-arrow)"/>
                    <line x1="590" y1="42" x2="460" y2="58" stroke="#C2703E" stroke-width="1" marker-end="url(#g2p-arrow)"/>

                    <!-- === FAYDA ID BAR (orange, prominent) === -->
                    <rect x="250" y="56" width="300" height="30" rx="4" fill="#2E1F0F" stroke="#C2703E" stroke-width="1.5"/>
                    <text x="400" y="75" text-anchor="middle" fill="#C2703E" font-size="10" font-family="IBM Plex Mono" font-weight="600">Fayda National ID Integration</text>

                    <!-- === ETHIO TELECOM CLOUD (left blue group) === -->
                    <rect x="10" y="105" width="370" height="260" rx="6" fill="#2D7DD2" fill-opacity="0.06" stroke="#2D7DD2" stroke-width="1"/>
                    <text x="195" y="122" text-anchor="middle" fill="#2D7DD2" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.1em">ETHIO TELECOM CLOUD</text>

                    <!-- RKE2 + Rancher -->
                    <rect x="22" y="134" width="168" height="50" rx="4" fill="#1B2838" stroke="#2D7DD2" stroke-width="1"/>
