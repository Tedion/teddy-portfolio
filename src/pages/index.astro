---
import Base from '../layouts/Base.astro';
---
<Base>
  <!-- ═══════════════════════════════════════════
       HEADER
  ═══════════════════════════════════════════ -->
  <header class="site-header" role="banner">
    <div class="container header-inner">
      <div class="header-identity">
        <a href="/" class="header-name">Teddy Abera Danamo</a>
        <span class="header-status t-mono">
          <span class="status-dot" aria-hidden="true"></span>
          3 active engagements · Addis Ababa
        </span>
      </div>
      <nav class="header-nav" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="hero section" aria-labelledby="hero-heading">
      <div class="container container--narrow">
        <p class="t-subheading reveal">DevOps & Platform Engineer</p>
        <h1 id="hero-heading" class="t-display hero-headline reveal">
          Designing, automating, and operating production infrastructure — from serverless AWS to national-scale government platforms.
        </h1>
        <div class="hero-anchors reveal">
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Currently</span>
            <p>Three concurrent engagements across US enterprise IT, distributed AI infrastructure with a patent-pending platform, and Ethiopian national digital transformation.</p>
          </div>
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Recently</span>
            <p>Co-validated 23 of 28 claims on a non-provisional utility patent for distributed deterministic execution framework architecture.</p>
          </div>
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Background</span>
            <p>4+ years production operations across banking, government, and cloud-native platforms. BSc Computer Science, Admas University.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SELECTED WORK
    ═══════════════════════════════════════════ -->
    <section id="work" class="section" aria-labelledby="work-heading">
      <div class="container">
        <p class="t-subheading reveal">Selected Work</p>
        <h2 id="work-heading" class="t-heading reveal">Case Studies</h2>

        <!-- PRIMARY CASE STUDIES -->
        <div class="case-studies">

          <!-- 1. NetrionX -->
          <article class="case-study reveal" id="cs-netrionx">
            <div class="case-study-header">
              <div class="case-study-meta">
                <span class="t-mono">Nov 2025 – Present</span>
                <span class="case-study-tag">Platform Engineering</span>
              </div>
              <h3 class="case-study-title">NetrionX DDEF Platform</h3>
              <p class="case-study-subtitle">Distributed AI-driven infrastructure orchestration with patent-validated architecture</p>
            </div>
            <div class="case-study-metrics">
              <div class="metric">
                <span class="metric-value t-mono">5 nodes</span>
                <span class="metric-label">AWS + GCP + Edge</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">11.6ms</span>
                <span class="metric-label">avg RTT, 0.35ms jitter</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">23/28</span>
                <span class="metric-label">patent claims validated</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">20,820+</span>
                <span class="metric-label">AI decision cycles</span>
              </div>
            </div>
            <details class="case-study-detail">
              <summary>Read full case study</summary>
              <div class="case-study-body">
                <p>Architected and deployed a 5-node distributed platform spanning AWS, GCP, and physical edge (Jetson Nano), connected via WireGuard/VXLAN mesh overlay. Built SR-MPLS transport fabric using FRRouting with IS-IS adjacency and BGP AS65001, assigning segment routing labels for deterministic path selection.</p>
                <p>Configured ONOS SDN controller with OpenFlow 1.3 managing 4 virtual devices and 12 bidirectional links. Integrated autonomous DQN + LSTM decision engine executing 20,820+ decision cycles with 1,015+ autonomous placement actions at 2ms latency and 84.5% average confidence.</p>
                <p>Built heterogeneous inference pipeline across three GPU tiers — T4 (PyTorch, 150ms), L4 (ONNX-GPU, 90ms), Jetson Nano (TensorRT FP16, 24ms). Built Grafana observability stack with 29 real-time panels covering system metrics, network health, AI engine telemetry, and ONOS topology.</p>
                <!-- NetrionX Architecture Diagram -->
                <div class="diagram-placeholder" aria-label="NetrionX DDEF platform architecture">
                  <svg viewBox="0 0 800 520" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Distributed AI infrastructure with SDN control plane, SR-MPLS fabric, and heterogeneous GPU compute">
                    <!-- === CONTROL PLANE === -->
                    <rect x="240" y="8" width="320" height="72" rx="4" stroke="#C2703E" stroke-width="1.5" fill="#161618"/>
                    <text x="400" y="30" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.1em">CONTROL PLANE</text>
                    <text x="400" y="48" text-anchor="middle" fill="#E8E4DF" font-size="11" font-family="IBM Plex Mono" font-weight="500">ONOS SDN Controller</text>
                    <text x="400" y="66" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">OpenFlow 1.3 · 4 devices · 12 bidir links · intent-based control</text>

                    <!-- === AI DECISION ENGINE === -->
                    <rect x="600" y="100" width="185" height="90" rx="4" stroke="#C2703E" stroke-width="1" fill="#161618"/>
                    <text x="692" y="120" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.1em">AI ENGINE</text>
                    <text x="692" y="138" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono">DQN + LSTM</text>
                    <text x="692" y="155" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">20,820+ decisions</text>
                    <text x="692" y="170" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">84.5% conf · 2ms lat</text>
                    <text x="692" y="183" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">1,015+ placements</text>
                    <!-- Arrow: AI Engine → ONOS -->
                    <line x1="600" y1="130" x2="560" y2="60" stroke="#C2703E" stroke-width="1" marker-end="url(#arrow)"/>
                    <text x="590" y="90" text-anchor="end" fill="#C2703E" font-size="7" font-family="IBM Plex Mono">placement</text>

                    <!-- === SR-MPLS TRANSPORT FABRIC === -->
                    <rect x="15" y="100" width="565" height="48" rx="3" stroke="#2A2A2E" stroke-width="1" fill="none"/>
                    <text x="297" y="120" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.08em">SR-MPLS TRANSPORT FABRIC</text>
                    <text x="297" y="137" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">FRRouting · IS-IS adjacency · BGP AS65001 · Labels 16001–16004</text>

                    <!-- === COMPUTE NODES === -->
                    <!-- Node 1: AWS -->
                    <rect x="15" y="170" width="150" height="115" rx="4" stroke="#C2703E" stroke-width="1" fill="#161618"/>
                    <text x="90" y="190" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">AWS us-east-1</text>
                    <text x="90" y="208" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">NVIDIA T4 16GB</text>
                    <text x="90" y="226" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">PyTorch inference</text>
                    <text x="90" y="244" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">150ms latency</text>
                    <rect x="35" y="258" width="110" height="18" rx="2" fill="#1E1E21"/>
                    <text x="90" y="271" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16001</text>

                    <!-- Node 2: GCP -->
                    <rect x="180" y="170" width="150" height="115" rx="4" stroke="#C2703E" stroke-width="1" fill="#161618"/>
                    <text x="255" y="190" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">GCP us-central1</text>
                    <text x="255" y="208" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">NVIDIA L4 24GB</text>
                    <text x="255" y="226" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">ONNX-GPU runtime</text>
                    <text x="255" y="244" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">90ms latency</text>
                    <rect x="200" y="258" width="110" height="18" rx="2" fill="#1E1E21"/>
                    <text x="255" y="271" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16002</text>

                    <!-- Node 3: Edge -->
                    <rect x="345" y="170" width="150" height="115" rx="4" stroke="#C2703E" stroke-width="1" fill="#161618"/>
                    <text x="420" y="190" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">PHYSICAL EDGE</text>
                    <text x="420" y="208" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">Jetson Nano</text>
                    <text x="420" y="226" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">TensorRT FP16</text>
                    <text x="420" y="244" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">24ms latency</text>
                    <rect x="365" y="258" width="110" height="18" rx="2" fill="#1E1E21"/>
                    <text x="420" y="271" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16003</text>

                    <!-- Node 4: K3s Orchestrator -->
                    <rect x="510" y="170" width="150" height="115" rx="4" stroke="#2A2A2E" stroke-width="1" fill="#161618"/>
                    <text x="585" y="190" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">ORCHESTRATOR</text>
                    <text x="585" y="208" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">K3s Cluster</text>
                    <text x="585" y="226" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">NVIDIA RuntimeClass</text>
                    <text x="585" y="244" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">GPU-aware scheduling</text>
                    <rect x="530" y="258" width="110" height="18" rx="2" fill="#1E1E21"/>
                    <text x="585" y="271" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16004</text>

                    <!-- === MESH OVERLAY === -->
                    <line x1="90" y1="170" x2="90" y2="148" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="255" y1="170" x2="255" y2="148" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="420" y1="170" x2="420" y2="148" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="585" y1="170" x2="585" y2="148" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="3 3"/>

                    <!-- Horizontal mesh links between nodes -->
                    <line x1="165" y1="225" x2="180" y2="225" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="2 2"/>
                    <line x1="330" y1="225" x2="345" y2="225" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="2 2"/>
                    <line x1="495" y1="225" x2="510" y2="225" stroke="#2A2A2E" stroke-width="1" stroke-dasharray="2 2"/>

                    <!-- === NETWORK METRICS === -->
                    <rect x="15" y="305" width="360" height="40" rx="3" stroke="#2A2A2E" stroke-width="1" fill="#1E1E21"/>
                    <text x="195" y="322" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.08em">WIREGUARD / VXLAN MESH OVERLAY</text>
                    <text x="195" y="337" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">11.6ms avg RTT · 0.35ms jitter · all direct paths</text>

                    <!-- === OBSERVABILITY === -->
                    <rect x="395" y="305" width="390" height="40" rx="3" stroke="#2A2A2E" stroke-width="1" fill="#1E1E21"/>
                    <text x="590" y="322" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.08em">OBSERVABILITY · PROMETHEUS + GRAFANA</text>
                    <text x="590" y="337" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono">29 real-time panels · system · network · AI · ONOS topology</text>

                    <!-- Arrow marker -->
                    <defs>
                      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#C2703E"/>
                      </marker>
                    </defs>
                  </svg>
                </div>
                <div class="case-study-stack t-mono">Python · ONOS SDN · OpenFlow 1.3 · FRRouting · SR-MPLS · BGP · IS-IS · WireGuard · VXLAN · K3s · NVIDIA RuntimeClass · PyTorch · ONNX · TensorRT · Prometheus · Grafana</div>
              </div>
            </details>
          </article>

          <!-- 2. OpenG2P -->
          <article class="case-study reveal" id="cs-openg2p">
            <div class="case-study-header">
              <div class="case-study-meta">
                <span class="t-mono">Mid-2025 – Present</span>
                <span class="case-study-tag">Government Infrastructure</span>
              </div>
              <h3 class="case-study-title">OpenG2P Ethiopia</h3>
              <p class="case-study-subtitle">National-scale digital transformation for Ethiopia's Fayda ID-enabled welfare systems</p>
            </div>
            <div class="case-study-metrics">
              <div class="metric">
                <span class="metric-value t-mono">3 ministries</span>
                <span class="metric-label">ATI, MoWSA, EDRMC</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">Dual infra</span>
                <span class="metric-label">Ethio Telecom + On-prem</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">National</span>
                <span class="metric-label">Fayda ID scale, millions</span>
              </div>
            </div>
            <details class="case-study-detail">
              <summary>Read full case study</summary>
              <div class="case-study-body">
                <p>Leading DevOps implementation across three Ethiopian government entities — the Agricultural Transformation Institute, Ministry of Women and Social Affairs, and Ethiopian Disaster Risk Management Commission. Deployed production-grade RKE2 clusters with Rancher management, Istio service mesh with mTLS, and Keycloak SSO federation across all entities.</p>
                <p>Architected dual-infrastructure deployments spanning Ethio Telecom cloud and on-premises environments with HA infrastructure including Hardware RAID 1+0, XCP-ng hypervisor, and WireGuard VPN tunnels. Currently implementing large-scale beneficiary data migration from ODK to OpenG2P for national social protection programs.</p>
                <!-- OpenG2P Architecture Diagram -->
                <div class="diagram-placeholder" aria-label="OpenG2P dual infrastructure topology">
                  <svg viewBox="0 0 800 380" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Dual-infrastructure government deployment across Ethio Telecom and on-premises">
                    <!-- === MINISTRY CONSUMERS === -->
                    <rect x="155" y="8" width="120" height="30" rx="3" fill="#1E1E21" stroke="#C2703E" stroke-width="1"/>
                    <text x="215" y="27" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">ATI</text>
                    <rect x="340" y="8" width="120" height="30" rx="3" fill="#1E1E21" stroke="#C2703E" stroke-width="1"/>
                    <text x="400" y="27" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">MoWSA</text>
                    <rect x="525" y="8" width="120" height="30" rx="3" fill="#1E1E21" stroke="#C2703E" stroke-width="1"/>
                    <text x="585" y="27" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">EDRMC</text>
                    <text x="40" y="27" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">MINISTRIES</text>
                    <!-- Arrows down to Fayda ID -->
                    <line x1="215" y1="38" x2="350" y2="62" stroke="#2A2A2E" stroke-width="1"/>
                    <line x1="400" y1="38" x2="400" y2="62" stroke="#2A2A2E" stroke-width="1"/>
                    <line x1="585" y1="38" x2="450" y2="62" stroke="#2A2A2E" stroke-width="1"/>
                    <!-- Fayda ID bar -->
                    <rect x="280" y="55" width="240" height="26" rx="3" fill="#161618" stroke="#C2703E" stroke-width="1.5"/>
                    <text x="400" y="72" text-anchor="middle" fill="#C2703E" font-size="9" font-family="IBM Plex Mono" font-weight="500">Fayda National ID Integration</text>

                    <!-- === ETHIO TELECOM CLOUD === -->
                    <rect x="15" y="100" width="370" height="210" rx="4" stroke="#2A2A2E" stroke-width="1" fill="none"/>
                    <text x="200" y="118" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.1em">ETHIO TELECOM CLOUD</text>
                    <!-- RKE2 + Rancher -->
                    <rect x="30" y="132" width="160" height="48" rx="3" fill="#161618" stroke="#C2703E" stroke-width="1"/>
                    <text x="110" y="152" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">RKE2 Cluster</text>
                    <text x="110" y="168" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">Rancher management</text>
                    <!-- Istio -->
                    <rect x="205" y="132" width="165" height="48" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="287" y="152" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono">Istio Service Mesh</text>
                    <text x="287" y="168" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">mTLS · traffic mgmt</text>
                    <!-- Keycloak -->
                    <rect x="30" y="195" width="110" height="44" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="85" y="214" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">Keycloak SSO</text>
                    <text x="85" y="229" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">cross-entity federation</text>
                    <!-- OpenG2P -->
                    <rect x="155" y="195" width="110" height="44" rx="3" fill="#161618" stroke="#C2703E" stroke-width="1"/>
                    <text x="210" y="214" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">OpenG2P</text>
                    <text x="210" y="229" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">G2P platform</text>
                    <!-- Helm -->
                    <rect x="280" y="195" width="90" height="44" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="325" y="214" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">Helm Charts</text>
                    <text x="325" y="229" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">umbrella stacks</text>
                    <!-- ODK data migration -->
                    <rect x="30" y="254" width="340" height="30" rx="3" fill="#1E1E21" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="200" y="274" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">ODK → OpenG2P beneficiary data migration · national scale</text>

                    <!-- === WIREGUARD VPN === -->
                    <line x1="385" y1="200" x2="415" y2="200" stroke="#C2703E" stroke-width="2" stroke-dasharray="6 3"/>
                    <line x1="385" y1="220" x2="415" y2="220" stroke="#C2703E" stroke-width="2" stroke-dasharray="6 3"/>
                    <text x="400" y="245" text-anchor="middle" fill="#C2703E" font-size="8" font-family="IBM Plex Mono">WireGuard</text>
