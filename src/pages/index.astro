                    <text x="600" y="353" text-anchor="middle" fill="#9B59B6" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.1em">OBSERVABILITY</text>
                    <rect x="425" y="358" width="130" height="22" rx="3" fill="#1F1B2E" stroke="#9B59B6" stroke-width="0.5"/>
                    <text x="490" y="373" text-anchor="middle" fill="#E8E4DF" font-size="8" font-family="IBM Plex Mono">Prometheus</text>
                    <rect x="565" y="358" width="90" height="22" rx="3" fill="#1F1B2E" stroke="#9B59B6" stroke-width="0.5"/>
                    <text x="610" y="373" text-anchor="middle" fill="#E8E4DF" font-size="8" font-family="IBM Plex Mono">Grafana</text>
