---
import Base from '../layouts/Base.astro';
---
<Base>
  <!-- ═══════════════════════════════════════════
       HEADER
  ═══════════════════════════════════════════ -->
  <header class="site-header" role="banner">
    <div class="container header-inner">
      <div class="header-identity">
        <a href="/" class="header-name">Teddy Abera Danamo</a>
        <span class="header-status t-mono">
          <span class="status-dot" aria-hidden="true"></span>
          3 active engagements · Addis Ababa
        </span>
      </div>
      <nav class="header-nav" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="hero section" aria-labelledby="hero-heading">
      <div class="container container--narrow">
        <p class="t-subheading reveal">DevOps & Platform Engineer</p>
        <h1 id="hero-heading" class="t-display hero-headline reveal">
          Designing, automating, and operating production infrastructure — from serverless AWS to national-scale government platforms.
        </h1>
        <div class="hero-anchors reveal">
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Currently</span>
            <p>Three concurrent engagements across US enterprise IT, distributed AI infrastructure with a patent-pending platform, and Ethiopian national digital transformation.</p>
          </div>
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Recently</span>
            <p>Co-validated 23 of 28 claims on a non-provisional utility patent for distributed deterministic execution framework architecture.</p>
          </div>
          <div class="hero-anchor">
            <span class="hero-anchor-label t-mono">Background</span>
            <p>4+ years production operations across banking, government, and cloud-native platforms. BSc Computer Science, Admas University.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SELECTED WORK
    ═══════════════════════════════════════════ -->
    <section id="work" class="section" aria-labelledby="work-heading">
      <div class="container">
        <p class="t-subheading reveal">Selected Work</p>
        <h2 id="work-heading" class="t-heading reveal">Case Studies</h2>

        <!-- PRIMARY CASE STUDIES -->
        <div class="case-studies">

          <!-- 1. NetrionX -->
          <article class="case-study reveal" id="cs-netrionx">
            <div class="case-study-header">
              <div class="case-study-meta">
                <span class="t-mono">Nov 2025 – Present</span>
                <span class="case-study-tag">Platform Engineering</span>
              </div>
              <h3 class="case-study-title">NetrionX DDEF Platform</h3>
              <p class="case-study-subtitle">Distributed AI-driven infrastructure orchestration with patent-validated architecture</p>
            </div>
            <div class="case-study-metrics">
              <div class="metric">
                <span class="metric-value t-mono">5 nodes</span>
                <span class="metric-label">AWS + GCP + Edge</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">11.6ms</span>
                <span class="metric-label">avg RTT, 0.35ms jitter</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">23/28</span>
                <span class="metric-label">patent claims validated</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">20,820+</span>
                <span class="metric-label">AI decision cycles</span>
              </div>
            </div>
            <details class="case-study-detail">
              <summary>Read full case study</summary>
              <div class="case-study-body">
                <p>Architected and deployed a 5-node distributed platform spanning AWS, GCP, and physical edge (Jetson Nano), connected via WireGuard/VXLAN mesh overlay. Built SR-MPLS transport fabric using FRRouting with IS-IS adjacency and BGP AS65001, assigning segment routing labels for deterministic path selection.</p>
                <p>Configured ONOS SDN controller with OpenFlow 1.3 managing 4 virtual devices and 12 bidirectional links. Integrated autonomous DQN + LSTM decision engine executing 20,820+ decision cycles with 1,015+ autonomous placement actions at 2ms latency and 84.5% average confidence.</p>
                <p>Built heterogeneous inference pipeline across three GPU tiers — T4 (PyTorch, 150ms), L4 (ONNX-GPU, 90ms), Jetson Nano (TensorRT FP16, 24ms). Built Grafana observability stack with 29 real-time panels covering system metrics, network health, AI engine telemetry, and ONOS topology.</p>
                <!-- NetrionX Architecture Diagram -->
                <div class="diagram-placeholder" aria-label="NetrionX DDEF platform architecture">
                  <svg viewBox="0 0 800 520" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Distributed AI infrastructure with SDN control plane, SR-MPLS fabric, and heterogeneous GPU compute">
                    <defs>
                      <marker id="nx-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#343A40"/>
                      </marker>
                      <marker id="nx-arrow-purple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#6F42C1"/>
                      </marker>
                    </defs>

                    <!-- Background -->
                    <rect width="800" height="520" fill="#FFFFFF"/>

                    <!-- === ONOS SDN Control Plane (orange dashed zone) === -->
                    <rect x="60" y="10" width="480" height="90" rx="6" fill="#FFF8F0" stroke="#FF9900" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="80" y="28" fill="#FF9900" font-size="9" font-family="IBM Plex Sans" font-weight="600">ONOS SDN Control Plane</text>
                    <!-- ONOS Controller box -->
                    <rect x="140" y="38" width="320" height="50" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="160" cy="63" r="6" fill="#2D7DD2"/>
                    <text x="175" y="58" fill="#232F3E" font-size="11" font-family="IBM Plex Sans" font-weight="500">ONOS SDN Controller</text>
                    <text x="175" y="74" fill="#6C757D" font-size="8" font-family="IBM Plex Sans">OpenFlow 1.3 · 4 devices · 12 links</text>

                    <!-- Arrow: ONOS -> Fabric -->
                    <line x1="300" y1="88" x2="300" y2="120" stroke="#343A40" stroke-width="1" marker-end="url(#nx-arrow)"/>
                    <text x="310" y="108" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">OpenFlow 1.3</text>

                    <!-- === SR-MPLS Transport Fabric (green dashed zone) === -->
                    <rect x="60" y="120" width="480" height="70" rx="6" fill="#E8F4E8" stroke="#248814" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="80" y="138" fill="#248814" font-size="9" font-family="IBM Plex Sans" font-weight="600">SR-MPLS Transport Fabric</text>
                    <!-- FRRouting box -->
                    <rect x="140" y="145" width="320" height="36" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="160" cy="163" r="6" fill="#248814"/>
                    <text x="175" y="160" fill="#232F3E" font-size="11" font-family="IBM Plex Sans" font-weight="500">FRRouting</text>
                    <text x="175" y="174" fill="#6C757D" font-size="8" font-family="IBM Plex Sans">IS-IS · BGP AS65001 · Labels 16001-16004</text>

                    <!-- Arrow: Fabric -> GPU Nodes -->
                    <line x1="300" y1="190" x2="300" y2="222" stroke="#343A40" stroke-width="1" marker-end="url(#nx-arrow)"/>
                    <text x="310" y="210" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">WireGuard / VXLAN</text>

                    <!-- === GPU Compute Nodes (blue dashed zone) === -->
                    <rect x="60" y="222" width="480" height="110" rx="6" fill="#E8EEF8" stroke="#527FFF" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="80" y="240" fill="#527FFF" font-size="9" font-family="IBM Plex Sans" font-weight="600">GPU Compute Nodes</text>

                    <!-- Node 1: AWS T4 -->
                    <rect x="75" y="250" width="108" height="68" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="91" cy="266" r="5" fill="#FF9900"/>
                    <text x="101" y="270" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">AWS T4</text>
                    <text x="129" y="288" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">PyTorch</text>
                    <text x="129" y="302" text-anchor="middle" fill="#232F3E" font-size="8" font-family="IBM Plex Sans" font-weight="500">150ms</text>

                    <!-- Node 2: GCP L4 -->
                    <rect x="195" y="250" width="108" height="68" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="211" cy="266" r="5" fill="#4285F4"/>
                    <text x="221" y="270" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">GCP L4</text>
                    <text x="249" y="288" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">ONNX-GPU</text>
                    <text x="249" y="302" text-anchor="middle" fill="#232F3E" font-size="8" font-family="IBM Plex Sans" font-weight="500">90ms</text>

                    <!-- Node 3: Jetson Nano -->
                    <rect x="315" y="250" width="108" height="68" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="331" cy="266" r="5" fill="#76B900"/>
                    <text x="341" y="270" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">Jetson Nano</text>
                    <text x="369" y="288" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">TensorRT FP16</text>
                    <text x="369" y="302" text-anchor="middle" fill="#232F3E" font-size="8" font-family="IBM Plex Sans" font-weight="500">24ms</text>

                    <!-- Node 4: K3s Orchestrator -->
                    <rect x="435" y="250" width="96" height="68" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="451" cy="266" r="5" fill="#326CE5"/>
                    <text x="461" y="270" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">K3s</text>
                    <text x="483" y="288" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">Orchestrator</text>
                    <text x="483" y="302" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">GPU-aware</text>

                    <!-- === AI Decision Engine (purple dashed zone, right side) === -->
                    <rect x="580" y="10" width="200" height="322" rx="6" fill="#F3EEFB" stroke="#6F42C1" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="600" y="28" fill="#6F42C1" font-size="9" font-family="IBM Plex Sans" font-weight="600">AI Decision Engine</text>

                    <!-- DQN+LSTM box -->
                    <rect x="600" y="42" width="160" height="80" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="618" cy="60" r="6" fill="#6F42C1"/>
                    <text x="632" y="64" fill="#232F3E" font-size="11" font-family="IBM Plex Sans" font-weight="500">DQN + LSTM</text>
                    <text x="680" y="82" text-anchor="middle" fill="#6C757D" font-size="8" font-family="IBM Plex Sans">20,820+ decisions</text>
                    <text x="680" y="96" text-anchor="middle" fill="#6C757D" font-size="8" font-family="IBM Plex Sans">84.5% confidence · 2ms</text>

                    <!-- Arrow: AI Engine → K3s "placement" -->
                    <line x1="680" y1="122" x2="680" y2="260" stroke="#6F42C1" stroke-width="1" stroke-dasharray="4 3"/>
                    <line x1="680" y1="260" x2="533" y2="260" stroke="#6F42C1" stroke-width="1" marker-end="url(#nx-arrow-purple)"/>
                    <text x="620" y="200" fill="#6F42C1" font-size="7.5" font-family="IBM Plex Sans">placement</text>

                    <!-- === Observability strip === -->
                    <rect x="60" y="352" width="720" height="70" rx="6" fill="#F8F9FA" stroke="#DEE2E6" stroke-width="1"/>
                    <text x="80" y="370" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="600">Observability</text>

                    <!-- Prometheus box -->
                    <rect x="80" y="380" width="120" height="32" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="96" cy="396" r="5" fill="#E6522C"/>
                    <text x="108" y="400" fill="#232F3E" font-size="9" font-family="IBM Plex Sans">Prometheus</text>

                    <!-- Arrow -->
                    <line x1="200" y1="396" x2="240" y2="396" stroke="#343A40" stroke-width="1" marker-end="url(#nx-arrow)"/>

                    <!-- Grafana box -->
                    <rect x="242" y="380" width="100" height="32" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="258" cy="396" r="5" fill="#F46800"/>
                    <text x="270" y="400" fill="#232F3E" font-size="9" font-family="IBM Plex Sans">Grafana</text>

                    <!-- Arrow -->
                    <line x1="342" y1="396" x2="382" y2="396" stroke="#343A40" stroke-width="1" marker-end="url(#nx-arrow)"/>

                    <!-- 29 panels box -->
                    <rect x="384" y="380" width="100" height="32" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <text x="434" y="400" text-anchor="middle" fill="#232F3E" font-size="9" font-family="IBM Plex Sans">29 panels</text>

                    <!-- Bottom annotation -->
                    <text x="400" y="460" text-anchor="middle" fill="#6C757D" font-size="9" font-family="IBM Plex Sans">11.6ms avg RTT · 0.35ms jitter</text>
                  </svg>
                </div>
                <div class="case-study-stack t-mono">Python · ONOS SDN · OpenFlow 1.3 · FRRouting · SR-MPLS · BGP · IS-IS · WireGuard · VXLAN · K3s · NVIDIA RuntimeClass · PyTorch · ONNX · TensorRT · Prometheus · Grafana</div>
              </div>
            </details>
          </article>

          <!-- 2. OpenG2P -->
          <article class="case-study reveal" id="cs-openg2p">
            <div class="case-study-header">
              <div class="case-study-meta">
                <span class="t-mono">Mid-2025 – Present</span>
                <span class="case-study-tag">Government Infrastructure</span>
              </div>
              <h3 class="case-study-title">OpenG2P Ethiopia</h3>
              <p class="case-study-subtitle">National-scale digital transformation for Ethiopia's Fayda ID-enabled welfare systems</p>
            </div>
            <div class="case-study-metrics">
              <div class="metric">
                <span class="metric-value t-mono">3 ministries</span>
                <span class="metric-label">ATI, MoWSA, EDRMC</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">Dual infra</span>
                <span class="metric-label">Ethio Telecom + On-prem</span>
              </div>
              <div class="metric">
                <span class="metric-value t-mono">National</span>
                <span class="metric-label">Fayda ID scale, millions</span>
              </div>
            </div>
            <details class="case-study-detail">
              <summary>Read full case study</summary>
              <div class="case-study-body">
                <p>Leading DevOps implementation across three Ethiopian government entities — the Agricultural Transformation Institute, Ministry of Women and Social Affairs, and Ethiopian Disaster Risk Management Commission. Deployed production-grade RKE2 clusters with Rancher management, Istio service mesh with mTLS, and Keycloak SSO federation across all entities.</p>
                <p>Architected dual-infrastructure deployments spanning Ethio Telecom cloud and on-premises environments with HA infrastructure including Hardware RAID 1+0, XCP-ng hypervisor, and WireGuard VPN tunnels. Currently implementing large-scale beneficiary data migration from ODK to OpenG2P for national social protection programs.</p>
                <!-- OpenG2P Architecture Diagram -->
                <div class="diagram-placeholder" aria-label="OpenG2P dual infrastructure topology">
                  <svg viewBox="0 0 800 440" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Dual-infrastructure government deployment across Ethio Telecom and on-premises">
                    <defs>
                      <marker id="g2p-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#343A40"/>
                      </marker>
                    </defs>

                    <!-- Background -->
                    <rect width="800" height="440" fill="#FFFFFF"/>

                    <!-- === Ministry Consumers (top row) === -->
                    <rect x="140" y="10" width="130" height="38" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="158" cy="29" r="5" fill="#FF9900"/>
                    <text x="170" y="33" fill="#232F3E" font-size="10" font-family="IBM Plex Sans" font-weight="500">ATI</text>

                    <rect x="335" y="10" width="130" height="38" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="353" cy="29" r="5" fill="#FF9900"/>
                    <text x="365" y="33" fill="#232F3E" font-size="10" font-family="IBM Plex Sans" font-weight="500">MoWSA</text>

                    <rect x="530" y="10" width="130" height="38" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="548" cy="29" r="5" fill="#FF9900"/>
                    <text x="560" y="33" fill="#232F3E" font-size="10" font-family="IBM Plex Sans" font-weight="500">EDRMC</text>

                    <!-- Arrows down to Fayda ID -->
                    <line x1="205" y1="48" x2="340" y2="68" stroke="#343A40" stroke-width="1" marker-end="url(#g2p-arrow)"/>
                    <line x1="400" y1="48" x2="400" y2="68" stroke="#343A40" stroke-width="1" marker-end="url(#g2p-arrow)"/>
                    <line x1="595" y1="48" x2="462" y2="68" stroke="#343A40" stroke-width="1" marker-end="url(#g2p-arrow)"/>

                    <!-- === Fayda National ID bar === -->
                    <rect x="250" y="66" width="300" height="34" rx="4" fill="#FFF3E0" stroke="#FF9900" stroke-width="1"/>
                    <text x="400" y="87" text-anchor="middle" fill="#232F3E" font-size="11" font-family="IBM Plex Sans" font-weight="600">Fayda National ID</text>

                    <!-- Arrows: Fayda -> Zones -->
                    <line x1="340" y1="100" x2="195" y2="125" stroke="#343A40" stroke-width="1" stroke-dasharray="4 3" marker-end="url(#g2p-arrow)"/>
                    <line x1="460" y1="100" x2="605" y2="125" stroke="#343A40" stroke-width="1" stroke-dasharray="4 3" marker-end="url(#g2p-arrow)"/>

                    <!-- === Ethio Telecom Cloud (left, blue dashed) === -->
                    <rect x="15" y="125" width="360" height="250" rx="6" fill="#E8EEF8" stroke="#527FFF" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="35" y="143" fill="#527FFF" font-size="9" font-family="IBM Plex Sans" font-weight="600">Ethio Telecom Cloud</text>

                    <!-- RKE2 + Rancher -->
                    <rect x="30" y="155" width="160" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="46" cy="177" r="5" fill="#326CE5"/>
                    <text x="58" y="173" fill="#232F3E" font-size="9.5" font-family="IBM Plex Sans" font-weight="500">RKE2 + Rancher</text>
                    <text x="58" y="187" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">Cluster management</text>

                    <!-- Istio -->
                    <rect x="200" y="155" width="160" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="216" cy="177" r="5" fill="#466BB0"/>
                    <text x="228" y="173" fill="#232F3E" font-size="9.5" font-family="IBM Plex Sans" font-weight="500">Istio</text>
                    <text x="228" y="187" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">mTLS service mesh</text>

                    <!-- Keycloak SSO -->
                    <rect x="30" y="210" width="110" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="46" cy="232" r="5" fill="#4D4D4D"/>
                    <text x="58" y="228" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">Keycloak SSO</text>
                    <text x="58" y="242" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">Federation</text>

                    <!-- OpenG2P -->
                    <rect x="150" y="210" width="100" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="166" cy="232" r="5" fill="#248814"/>
                    <text x="178" y="228" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">OpenG2P</text>
