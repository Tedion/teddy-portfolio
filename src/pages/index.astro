                    <!-- === ON-PREMISES === -->
                    <rect x="415" y="100" width="370" height="210" rx="4" stroke="#2A2A2E" stroke-width="1" fill="none"/>
                    <text x="600" y="118" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono" letter-spacing="0.1em">ON-PREMISES INFRASTRUCTURE</text>
                    <!-- XCP-ng -->
                    <rect x="430" y="132" width="160" height="48" rx="3" fill="#161618" stroke="#C2703E" stroke-width="1"/>
                    <text x="510" y="152" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="500">XCP-ng Hypervisor</text>
                    <text x="510" y="168" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">HA virtualization</text>
                    <!-- RKE2 on-prem -->
                    <rect x="605" y="132" width="165" height="48" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="687" y="152" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono">RKE2 Cluster</text>
                    <text x="687" y="168" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">production workloads</text>
                    <!-- Storage -->
                    <rect x="430" y="195" width="160" height="44" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="510" y="214" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">Hardware RAID 1+0</text>
                    <text x="510" y="229" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">redundant storage</text>
                    <!-- Monitoring -->
                    <rect x="605" y="195" width="165" height="44" rx="3" fill="#161618" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="687" y="214" text-anchor="middle" fill="#E8E4DF" font-size="9" font-family="IBM Plex Mono">Prometheus</text>
                    <text x="687" y="229" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">Grafana · Alertmanager</text>
                    <!-- Scale label -->
                    <rect x="430" y="254" width="340" height="30" rx="3" fill="#1E1E21" stroke="#2A2A2E" stroke-width="1"/>
                    <text x="600" y="274" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">serving millions of citizens · Fayda ID-enabled social protection</text>
                  </svg>
                </div>
                <div class="case-study-stack t-mono">RKE2 · Rancher · Istio · Keycloak · XCP-ng · WireGuard · OpenG2P · Helm</div>
              </div>
            </details>
          </article>

          <!-- 3. WeTruck -->
          <article class="case-study reveal" id="cs-wetruck">
            <div class="case-study-header">
              <div class="case-study-meta">
                <span class="t-mono">Jan 2025 – Apr 2025</span>
                <span class="case-study-tag">Serverless Architecture</span>
              </div>
