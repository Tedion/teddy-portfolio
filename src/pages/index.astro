                    <!-- Helm -->
                    <rect x="260" y="210" width="100" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="276" cy="232" r="5" fill="#0F1689"/>
                    <text x="288" y="228" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">Helm</text>
                    <text x="288" y="242" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">Charts</text>

                    <!-- ODK migration -->
                    <rect x="30" y="266" width="335" height="36" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <text x="197" y="282" text-anchor="middle" fill="#232F3E" font-size="9" font-family="IBM Plex Sans" font-weight="500">ODK --> OpenG2P migration</text>
                    <text x="197" y="294" text-anchor="middle" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">National-scale beneficiary data</text>

                    <!-- === WireGuard VPN (center dashed line) === -->
                    <line x1="375" y1="160" x2="425" y2="160" stroke="#6C757D" stroke-width="1.5" stroke-dasharray="6 3"/>
                    <line x1="375" y1="200" x2="425" y2="200" stroke="#6C757D" stroke-width="1.5" stroke-dasharray="6 3"/>
                    <line x1="375" y1="240" x2="425" y2="240" stroke="#6C757D" stroke-width="1.5" stroke-dasharray="6 3"/>
                    <text x="400" y="280" text-anchor="middle" fill="#6C757D" font-size="8" font-family="IBM Plex Sans" font-weight="500">WireGuard VPN</text>

                    <!-- === On-Premises (right, gray dashed) === -->
                    <rect x="425" y="125" width="360" height="250" rx="6" fill="#F0F0F0" stroke="#666666" stroke-width="1" stroke-dasharray="6 3"/>
                    <text x="445" y="143" fill="#666666" font-size="9" font-family="IBM Plex Sans" font-weight="600">On-Premises</text>

                    <!-- XCP-ng -->
                    <rect x="440" y="155" width="160" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="456" cy="177" r="5" fill="#019642"/>
                    <text x="468" y="173" fill="#232F3E" font-size="9.5" font-family="IBM Plex Sans" font-weight="500">XCP-ng</text>
                    <text x="468" y="187" fill="#6C757D" font-size="7.5" font-family="IBM Plex Sans">HA virtualization</text>

                    <!-- RKE2 on-prem -->
                    <rect x="610" y="155" width="160" height="44" rx="4" fill="#FFFFFF" stroke="#DEE2E6" stroke-width="1"/>
                    <circle cx="626" cy="177" r="5" fill="#326CE5"/>
                    <text x="638" y="173" fill="#232F3E" font-size="9.5" font-family="IBM Plex Sans" font-weight="500">RKE2</text>
