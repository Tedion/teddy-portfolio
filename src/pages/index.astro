                    <text x="404" y="228" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="600">Jetson Nano</text>
                    <text x="404" y="244" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">TensorRT FP16</text>
                    <text x="404" y="260" text-anchor="middle" fill="#2D7DD2" font-size="9" font-family="IBM Plex Mono">24ms latency</text>
                    <rect x="349" y="270" width="110" height="18" rx="2" fill="#161618" stroke="#2D7DD2" stroke-width="0.5"/>
                    <text x="404" y="283" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16003</text>

                    <!-- Node 4: K3s Orchestrator -->
                    <rect x="487" y="195" width="135" height="110" rx="4" fill="#1B2838" stroke="#2D7DD2" stroke-width="1"/>
                    <text x="554" y="212" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono" letter-spacing="0.08em">ORCHESTRATOR</text>
                    <text x="554" y="228" text-anchor="middle" fill="#E8E4DF" font-size="10" font-family="IBM Plex Mono" font-weight="600">K3s Cluster</text>
                    <text x="554" y="244" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">NVIDIA RuntimeClass</text>
                    <text x="554" y="260" text-anchor="middle" fill="#847D78" font-size="8" font-family="IBM Plex Mono">GPU-aware sched</text>
                    <rect x="499" y="270" width="110" height="18" rx="2" fill="#161618" stroke="#2D7DD2" stroke-width="0.5"/>
                    <text x="554" y="283" text-anchor="middle" fill="#847D78" font-size="7" font-family="IBM Plex Mono">SID: 16004</text>

                    <!-- Vertical links: Fabric → Nodes -->
                    <line x1="94" y1="155" x2="94" y2="195" stroke="#C2703E" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="249" y1="155" x2="249" y2="195" stroke="#C2703E" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="404" y1="155" x2="404" y2="195" stroke="#C2703E" stroke-width="1" stroke-dasharray="3 3"/>
