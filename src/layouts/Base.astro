---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Teddy Abera Danamo — DevOps & Platform Engineer',
  description = 'DevOps and Platform Engineer designing, automating, and operating production-grade infrastructure across cloud-native, hybrid, and edge environments. Based in Addis Ababa.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="author" content="Teddy Abera Danamo" />
  <meta name="theme-color" content="#0C0C0E" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Person Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Teddy Abera Danamo",
    "jobTitle": "DevOps & Platform Engineer",
    "url": Astro.site?.toString(),
    "email": "tedionabera@gmail.com",
    "telephone": "+251910161555",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Addis Ababa",
      "addressCountry": "ET"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Admas University"
    },
    "sameAs": [
      "https://github.com/Tedion",
      "https://www.linkedin.com/in/teddy-abera/"
    ]
  })} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />

  <!-- Font Preload (critical path) -->
  <link rel="preload" href="/fonts/instrument-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>
  <slot />

  <!-- Scroll reveal observer — progressive enhancement, no-JS still works -->
  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    }
  </script>
</body>
</html>
